# Server IP — used to build correct redirect URLs
SERVER_IP=192.168.1.103

# Postgres password
POSTGRES_PASSWORD=change-me-in-production

# JWT — generate with: openssl rand -base64 32
# All three values below must match: ANON_KEY and SERVICE_ROLE_KEY are
# JWTs signed with JWT_SECRET. For local dev you can use these defaults.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiJ-BvFBLyFi0yFqFI-n0YzWqpwH3d-AITpG1U
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# Google OAuth (optional — leave blank to use email magic link)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protomaps — world map tiles (free key at protomaps.com, 200k requests/month)
NEXT_PUBLIC_PROTOMAPS_API_KEY=
